# Sao chép file này thành ".env" rồi sửa giá trị.

# Cơ sở dữ liệu. Trên máy: SQLite (file). Lên server có thể đổi sang PostgreSQL.
DATABASE_URL="file:./noithat.db"

# Địa chỉ website (dùng cho link trong email).
SITE_URL="http://localhost:3000"

# Gửi email (để trống: email được lưu lại trong Quản trị → Cài đặt → Email đã gửi, không gửi thật).
# Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT="587", SMTP_USER = Gmail, SMTP_PASS = Mật khẩu ứng dụng 16 chữ.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Nội Thất IRIS <no-reply@example.com>"

# Chuỗi bí mật ngẫu nhiên (đổi khi đưa lên server).
APP_SECRET="doi-chuoi-nay-khi-len-server"
